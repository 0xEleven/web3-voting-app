# Sepolia Ethereum Testnet Configuration (Bonus Feature)
# Get a free Sepolia RPC from Alchemy, Infura, or public node:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Export your testnet account private key from MetaMask (Do NOT share real funds!):
SEPOLIA_PRIVATE_KEY=your_private_key_here

# (Optional) For automated contract verification on Etherscan:
ETHERSCAN_API_KEY=your_etherscan_api_key_here
